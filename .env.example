ASSEMBLYAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Deployment only (README "Deploy"); leave empty for local runs ----
# Copy sessions, saved pack versions and the configuration log to Supabase (ia_files.sql). Local runs keep this off:
# with it on, startup also copies the deployed sessions into the local sessions/ folder.
SYNC_ENABLED=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Sign-in for a shared link: everyone uses this passcode. SESSION_SECRET signs the sign-in cookie (32+ random chars).
APP_PASSCODE=
SESSION_SECRET=
# All sessions together; paid models stop when the total reaches it. Empty or 0 = no cap (local default).
MAX_TOTAL_COST_USD=
